# =========================================================================
# Terraform & Infrastructure
# =========================================================================
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.log.*

# Exclude all .tfvars files, which are likely to contain sensitive data,
# such as passwords, private keys, and secrets.
*.tfvars
*.tfvars.json

# Ignore override files as they are local-only overrides.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI config files
.terraformrc
terraform.rc

